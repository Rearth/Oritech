{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oritech collision shape",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "coordinate_system", "boxes"],
  "properties": {
    "format_version": {"const": 1},
    "coordinate_system": {"const": "oritech:block_local_north"},
    "boxes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min", "max"],
        "properties": {
          "min": {"$ref": "#/$defs/vector"},
          "max": {"$ref": "#/$defs/vector"}
        }
      }
    }
  },
  "$defs": {
    "vector": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
  }
}
